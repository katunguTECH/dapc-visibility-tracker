generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("PRISMA_DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String    @unique
  name      String?
  hasPaid   Boolean   @default(false)
  plan      String    @default("Free")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  searches  Search[]
  documents Document[]
}

model Business {
  id             String    @id @default(cuid())
  name           String
  location       String
  category       String?
  visibilityScore Int      @default(0)
  lastAudit      DateTime  @default(now())
  searches       Search[]
}

model Search {
  id         String    @id @default(cuid())
  query      String
  timestamp  DateTime  @default(now())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  amount      Float
  phoneNumber String
  status      String   @default("PENDING")
  checkoutId  String   @unique
  createdAt   DateTime @default(now())
}

model Document {
  id          String    @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileType    String
  fileSize    Int
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  folder      String?
  tags        String[]
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  address   String
  phone     String?
  placeId   String   @unique
  status    String   @default("new")
  createdAt DateTime @default(now())
}
